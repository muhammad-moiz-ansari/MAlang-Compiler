%{
#include <iostream>
#include <string>
#include "parser.tab.h" /* This header will be generated by Bison in our next step */
%}

/* Tell Flex not to worry about reading multiple files */
%option noyywrap

%%

"{"         { return LBRACE; }
"}"         { return RBRACE; }
"["         { return LBRACKET; }
"]"         { return RBRACKET; }
":"         { return COLON; }
","         { return COMMA; }

"true"      { return TRUE_VAL; }
"false"     { return FALSE_VAL; }
"null"      { return NULL_VAL; }

\"([^\"\\]|\\.)*\" { 
    /* Matches strings and handles escaped characters. 
       Later, we will extract this text and pass it to Bison as a C++ std::string! */
    return STRING; 
}

-?[0-9]+(\.[0-9]+)?([eE][+-]?[0-9]+)? { 
    /* Matches integers, decimals, and scientific notation (for the bonus points).
       Later, we will convert this to a C++ double for Bison. */
    return NUMBER; 
}

[ \t\n\r]+  { /* Ignore all spaces, tabs, and newlines completely */ }

.           { 
    /* The fallback rule. If it hits an illegal character, print the exact error requested and exit. */
    std::cerr << "Error: unexpected token " << yytext << std::endl; 
    exit(1); 
}

%%