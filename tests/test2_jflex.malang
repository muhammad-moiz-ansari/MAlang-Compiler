## test2.malang - Complex Expressions

start function Calculate_math () {
    declare Base = 10 ;
    declare Height = +25.5 ;

    ## Arithmetic & Assignment
    Area = ( Base ** 2 ) + ( Height * 4 ) / 2 ;
    Total_score += 100 ;
    Count ++ ;

    ## Relational & Logical Expressions
    condition ( ( Area >= 100.0 ) && ( Total_score != 0 ) || ! false ) {
        output "Valid" ;
    } else {
        Total_score -- ;
    }
} finish